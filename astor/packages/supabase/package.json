{
  "name": "@astor/supabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "gen:types": "echo 'supabase gen types typescript --project-id <ID> --schema public > src/types.gen.ts'",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@astor/config": "workspace:*",
    "typescript": "^5.6.2"
  }
}
