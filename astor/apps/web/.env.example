# Env del web app. Copiar a apps/web/.env.local (Next lee el .env del dir del app).
# Los valores salen del panel de Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo backend (route handlers / server actions de superficies de agente). No cliente.
SUPABASE_SERVICE_ROLE_KEY=
