# ─────────────────────────────────────────────────────────────────────────────
# Astor — variables de entorno. Copiar a .env.local (nunca commitear .env*).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Fase 0) ───────────────────────────────────────────────────────────
# Panel Supabase → Project Settings → API. NUNCA pegar valores reales acá:
# este archivo es un TEMPLATE que se commitea. Los valores reales van en .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: SOLO backend (route handlers/cron/bot/mcp). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Owner / gating de agente (Fase 0/2) ─────────────────────────────────────────
# user_id (auth.users) del owner; el bootstrap setea profiles.agent_enabled=true.
ASTOR_OWNER_USER_ID=

# Agente / LLM — provider-agnóstico (Fase 2) ──────────────────────────────────
OPENROUTER_API_KEY=
# Modelo primario (OpenAI-compatible via OpenRouter).
OPENROUTER_MODEL=
# Cadena de fallback separada por comas (los :free rotan y se deslistan).
OPENROUTER_FALLBACK_MODELS=

# Telegram (Fase 2) ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Secreto para validar X-Telegram-Bot-Api-Secret-Token en el webhook.
TELEGRAM_WEBHOOK_SECRET=

# Transcripción de voz (Fase 2) ───────────────────────────────────────────────
# groq | openai
TRANSCRIBER_PROVIDER=
GROQ_API_KEY=

# Email — Resend ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cron interno de briefings (Fase 2) ──────────────────────────────────────────
# Secreto que valida el endpoint /api/internal/briefings (Vercel Cron).
ASTOR_CRON_SECRET=

# Finanzas — FX (Fase 3) ──────────────────────────────────────────────────────
# Proveedor de cotizaciones oficial/blue/MEP (con carga manual como fallback).
FX_RATES_PROVIDER=

# Google Calendar (Fase 5) ────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
